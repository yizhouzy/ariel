{
    "cSpell.customDictionaries": {
        "custom": true,
        "internal-terms": false,
        "project-words": {
            "addWords": true,
            "description": "Words used in this project",
            "name": "project-words",
            "path": "${workspaceRoot}/.vscode/project-words.txt"
        }
    },
    "explorerExclude.backup": {},
    "files.exclude": {
        "**/.git": false,
        "**/.svn": false,
        "**/.hg": false,
        "**/.DS_Store": false,
        "**/Thumbs.db": false,
        "**/.mypy_cache": false,
        "**/.nox": false,
        "**/.pytest_cache": false,
        "**/__pycache__": false,
        ".typings": false,
        ".venv": false,
        ".gitattributes": false,
        "LICENSE": false,
        "**/CODE_OF_CONDUCT.md": false,
        "**/CONTRIBUTING.md": false,
        "**/mypy.ini": false,
        "**/pyrightconfig.json": false,
        "**/pyproject.toml": false,
        "**/.editorconfig": false,
        "**/.pre-commit-config.yaml": false,
        "**/.python-version": false,
        ".python-version": false,
        "**/uv.lock": false,
        "*.lock": false,
        "uv.lock": false,
        "**/*.lock": false,
        "**/README.md": false,
        "*.md": false,
        "README.md": false,
        "**/*.md": false
    },
    "python-envs.pythonProjects": [],
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "ruff.path": [
        "/home/vscode/.local/bin/ruff"
    ],
    "workbench.iconTheme": "material-icon-theme"
}