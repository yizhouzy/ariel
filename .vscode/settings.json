{
    "cSpell.customDictionaries": {
        "custom": true,
        "internal-terms": false,
        "project-words": {
            "addWords": true,
            "description": "Words used in this project",
            "name": "project-words",
            "path": "${workspaceRoot}/.vscode/project-words.txt"
        }
    },
    "explorerExclude.backup": {},
    "files.exclude": {
        "**/.git": true,
        "**/.svn": false,
        "**/.hg": false,
        "**/.DS_Store": true,
        "**/Thumbs.db": false,
        "**/.mypy_cache": true,
        "**/.nox": true,
        "**/.pytest_cache": true,
        "**/__pycache__": true,
        ".typings": false,
        ".venv": false,
        ".gitattributes": true,
        "LICENSE": true,
        "**/CODE_OF_CONDUCT.md": true,
        "**/CONTRIBUTING.md": true,
        "**/mypy.ini": true,
        "**/pyrightconfig.json": true,
        "**/pyproject.toml": true,
        "**/.editorconfig": true,
        "**/.pre-commit-config.yaml": true,
        "**/.python-version": true,
        ".python-version": true,
        "**/uv.lock": true,
        "*.lock": true,
        "uv.lock": true,
        "**/*.lock": true,
        "**/README.md": true,
        "*.md": true,
        "README.md": true,
        "**/*.md": true
    },
    "python-envs.pythonProjects": [],
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "ruff.path": [
        "/home/vscode/.local/bin/ruff"
    ],
    "workbench.iconTheme": "material-icon-theme"
}